# Satır sonları: depoda ve çalışma dizininde her zaman LF.
# Windows'ta core.autocrlf=true olan bir klonda, çalışma anında üretilip
# depodakiyle bayt bayt karşılaştırılan dosyalar (docs/*/rig_spec.json gibi)
# CRLF'ye dönüşüp testleri kırıyordu; bu satır o ayarı yoldan bazında ezer.
* text=auto eol=lf
# Metin dosyaları
*.gd text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.gltf text eol=lf
# İkili dosyalar: dönüştürülmesin, farkı gösterilmesin
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.glb binary
*.blend binary
*.ttf binary
*.otf binary
*.zip binary
*.pck binary
# Git LFS: yalnızca yeni büyük dosyalar (dünya haritası karoları, 49 MB; kullanıcı
# kararı 2026-10-18). Geçmişteki büyük dosyaları taşımak (`git lfs migrate`) geçmişi
# yeniden yazar, yapılmadı (6.1).
data/assets/map/tiles/**/*.jpg filter=lfs diff=lfs merge=lfs -text
# Git LFS: büyük ikili dosyalar (görev 6.1, kullanıcı kararı 2026-10-20). Geçmiş yeniden
# yazılmadı; bu kurallar yeni eklenen ve yeniden normalleştirilen dosyalara uygulanır.
# Yeni dalda bütün dosyaları LFS'e almak için: git lfs install && git add --renormalize .
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text
